#!/bin/bash
# LUBARCHY live-build build wrapper. Bash with pipefail so a failing
# "lb build" cannot be hidden by tee.
set -euo pipefail

# Deterministic SOURCE_DATE_EPOCH from the checked-out commit.
# shellcheck source=build/live/auto/build-environment
. ./auto/build-environment

lb build noauto "${@}" 2>&1 | tee build.log
