{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lubarchy:packages:recovery-journal:v1",
  "title": "LUBARCHY package recovery journal v1",
  "description": "Durable runtime journal of one recovery of an interrupted hardware-package apply attempt (M1-L), stored as /var/lib/lubarchy/package-recoveries/<recovery>/journal.json and replaced atomically at every phase change. It binds the original apply attempt and its digests, records the observed real package state, the classification, the transaction closure and, separately, the transaction-attributed recovery impact set with its dpkg-log evidence, the authorised recovery targets, the action, any exact-package dpkg recovery argv (configure with trigger processing suppressed, then trigger processing as a separately authorised phase) with per-command dpkg-log containment evidence, and the result. It is evidence, not a rollback log, and it never contains command output, environment, secrets or caller text.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "recovery_id", "phase", "result", "failure", "mutation_started", "phases", "original", "observed",
               "classification", "reason", "action", "transaction_closure", "recovery_impact", "authorized_targets",
               "recovery_argv", "recovery_steps", "post_state"],
  "properties": {
    "schema": {"const": "lubarchy.packages.recovery-journal/v1"},
    "recovery_id": {"$ref": "#/$defs/id"},
    "phase": {"$ref": "#/$defs/phase"},
    "result": {"enum": [null, "complete", "abandoned", "manual_recovery_required", "failed"]},
    "failure": {
      "oneOf": [
        {"type": "null"},
        {"type": "object", "additionalProperties": false, "required": ["code", "phase"],
         "properties": {"code": {"type": "string", "pattern": "^[a-z_]{1,64}$"}, "phase": {"$ref": "#/$defs/phase"}}}
      ]
    },
    "mutation_started": {"type": "boolean"},
    "phases": {
      "type": "array", "minItems": 1,
      "items": {"type": "object", "additionalProperties": false, "required": ["phase", "at"],
                "properties": {"phase": {"$ref": "#/$defs/phase"},
                               "at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"}}}
    },
    "original": {
      "oneOf": [
        {"type": "null"},
        {"type": "object", "additionalProperties": false,
         "required": ["attempt_id", "phase", "apply_started", "transaction_digest", "bundle_digest",
                      "source_activation_digest", "repository_metadata_digest", "installed_state_digest_before"],
         "properties": {
           "attempt_id": {"$ref": "#/$defs/id"},
           "phase": {"enum": ["prepared", "locked", "source_activated", "metadata_refreshed", "transaction_revalidated",
                              "bundle_staged", "bundle_verified", "applying", "applied", "validated", "complete",
                              "failed"]},
           "apply_started": {"type": "boolean"},
           "transaction_digest": {"$ref": "#/$defs/optional_digest"},
           "bundle_digest": {"$ref": "#/$defs/optional_digest"},
           "source_activation_digest": {"$ref": "#/$defs/optional_digest"},
           "repository_metadata_digest": {"$ref": "#/$defs/optional_digest"},
           "installed_state_digest_before": {"$ref": "#/$defs/optional_digest"}}}
      ]
    },
    "observed": {
      "oneOf": [
        {"type": "null"},
        {"type": "object", "additionalProperties": false,
         "required": ["state_digest", "dpkg_audit_clean", "apt_check_ok", "pending", "pre_state_reconstructed"],
         "properties": {
           "state_digest": {"$ref": "#/$defs/digest"},
           "dpkg_audit_clean": {"type": "boolean"},
           "apt_check_ok": {"type": "boolean"},
           "pre_state_reconstructed": {"type": "boolean"},
           "pending": {"type": "array", "items": {"$ref": "#/$defs/package_state"}}}}
      ]
    },
    "classification": {"enum": [null, "no_mutation", "no_package_change", "applied_but_unvalidated",
                                "bounded_incomplete_transaction", "manual_recovery_required"]},
    "reason": {"oneOf": [{"type": "null"}, {"type": "string", "maxLength": 512}]},
    "action": {"enum": [null, "finalize", "validate_only", "configure_exact"]},
    "transaction_closure": {
      "oneOf": [
        {"type": "null"},
        {"type": "array", "minItems": 1, "items": {
          "type": "object", "additionalProperties": false, "required": ["package", "architecture", "version"],
          "properties": {"package": {"$ref": "#/$defs/package"}, "architecture": {"$ref": "#/$defs/architecture"},
                         "version": {"$ref": "#/$defs/version"}}}}
      ]
    },
    "recovery_impact": {
      "oneOf": [
        {"type": "null"},
        {"type": "object", "additionalProperties": false, "required": ["evidence", "packages"],
         "properties": {
           "evidence": {"type": "object", "additionalProperties": false,
                        "required": ["dpkg_log_cursor", "delta_sha256", "delta_lines"],
                        "properties": {
                          "dpkg_log_cursor": {"$ref": "#/$defs/log_cursor"},
                          "delta_sha256": {"$ref": "#/$defs/digest"},
                          "delta_lines": {"type": "integer", "minimum": 0}}},
           "packages": {"type": "array", "items": {
             "type": "object", "additionalProperties": false,
             "required": ["package", "architecture", "version", "pre_status", "observed_status", "activated_during",
                          "events", "interests"],
             "properties": {
               "package": {"$ref": "#/$defs/package"}, "architecture": {"$ref": "#/$defs/architecture"},
               "version": {"$ref": "#/$defs/version"},
               "pre_status": {"const": "install ok installed"},
               "observed_status": {"enum": ["install ok installed", "install ok half-configured",
                                            "install ok triggers-pending", "install ok triggers-awaited"]},
               "activated_during": {"oneOf": [{"type": "null"}, {"type": "string",
                                    "pattern": "^(install|configure|trigproc) [a-z0-9][a-z0-9+.-]{1,127}:[a-z0-9][a-z0-9-]{0,31}$"}]},
               "events": {"type": "array", "minItems": 1, "maxItems": 4096, "items": {
                 "enum": ["status triggers-pending", "status triggers-awaited", "status half-configured",
                          "status installed", "trigproc"]}},
               "interests": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[!-~]{1,256}$"}}}}}}}
      ]
    },
    "authorized_targets": {"type": "array", "items": {"$ref": "#/$defs/package"}},
    "recovery_argv": {"type": "array", "maxItems": 2, "items": {"$ref": "#/$defs/recovery_command"}},
    "recovery_steps": {
      "type": "array", "maxItems": 2,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["argv", "log_cursor", "delta_sha256", "delta_lines", "handlers", "pending_after"],
        "properties": {
          "argv": {"$ref": "#/$defs/recovery_command"},
          "log_cursor": {"$ref": "#/$defs/log_cursor"},
          "delta_sha256": {"$ref": "#/$defs/optional_digest"},
          "delta_lines": {"oneOf": [{"type": "null"}, {"type": "integer", "minimum": 0}]},
          "handlers": {"type": "array", "items": {"type": "string",
                       "pattern": "^(configure|trigproc) [a-z0-9][a-z0-9+.-]{1,127}:[a-z0-9][a-z0-9-]{0,31}$"}},
          "pending_after": {"oneOf": [{"type": "null"}, {"type": "array", "items": {
            "type": "object", "additionalProperties": false, "required": ["package", "status"],
            "properties": {"package": {"$ref": "#/$defs/package"},
                           "status": {"type": "string", "pattern": "^[a-z]+ [a-z]+ [a-z-]+$"}}}}]}
        }
      }
    },
    "post_state": {
      "oneOf": [
        {"type": "null"},
        {"type": "object", "additionalProperties": false, "required": ["packages"],
         "properties": {"packages": {"type": "array", "items": {
           "type": "object", "additionalProperties": false,
           "required": ["package", "architecture", "version", "status", "automatic"],
           "properties": {"package": {"$ref": "#/$defs/package"}, "architecture": {"$ref": "#/$defs/architecture"},
                          "version": {"$ref": "#/$defs/version"}, "status": {"const": "install ok installed"},
                          "automatic": {"type": "boolean"}}}}}}
      ]
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
    "phase": {"enum": ["prepared", "locked", "inspected", "classified", "verified", "recovering", "processing_triggers",
                       "recovered", "validated", "complete", "abandoned", "manual_recovery_required", "failed"]},
    "recovery_command": {
      "oneOf": [
        {"type": "array", "minItems": 4,
         "prefixItems": [{"const": "/usr/bin/dpkg"}, {"const": "--configure"}, {"const": "--no-triggers"}],
         "items": {"$ref": "#/$defs/package"}},
        {"type": "array", "minItems": 3,
         "prefixItems": [{"const": "/usr/bin/dpkg"}, {"const": "--triggers-only"}],
         "items": {"$ref": "#/$defs/package"}}
      ]
    },
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "optional_digest": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/digest"}]},
    "log_cursor": {"type": "object", "additionalProperties": false, "required": ["size", "sha256"],
                   "properties": {"size": {"type": "integer", "minimum": 0}, "sha256": {"$ref": "#/$defs/digest"}}},
    "package": {"type": "string", "pattern": "^[a-z0-9][a-z0-9+.-]{1,127}$"},
    "architecture": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,31}$"},
    "version": {"type": "string", "pattern": "^(?:[0-9]+:)?[0-9][A-Za-z0-9.+~-]{0,127}$"},
    "package_state": {
      "type": "object", "additionalProperties": false, "required": ["package", "architecture", "version", "status"],
      "properties": {"package": {"$ref": "#/$defs/package"}, "architecture": {"$ref": "#/$defs/architecture"},
                     "version": {"$ref": "#/$defs/version"},
                     "status": {"type": "string", "pattern": "^[a-z]+ [a-z]+ [a-z-]+$"}}
    }
  }
}
